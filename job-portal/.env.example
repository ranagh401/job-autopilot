# Copy this file to .env and fill in your values. Never share the .env file.

# Dashboard login password
DASHBOARD_PASSWORD=changeme

# Gmail (use your PERSONAL Gmail, not your company email).
# Requires 2-Step Verification ON, then create an App Password:
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Azure OpenAI (GPT-4o or GPT-5.x deployment both work)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Alternative: plain OpenAI (used only if Azure vars are empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Job source keys (all optional - free sources work without any keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
HUNTER_API_KEY=

# Behaviour
DAILY_EMAIL_CAP=50
SEND_WINDOW=9-19
SEND_BATCH=8
MATCH_THRESHOLD=65
CYCLE_MINUTES=60
FETCH_EVERY_HOURS=12
SCORE_LIMIT_PER_CYCLE=25
AUTO_DRAFT=true
JSEARCH_MAX_QUERIES=3
